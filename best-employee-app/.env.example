# Copy to .env (same folder as docker-compose.yaml) and fill in real values.
# .env is gitignored — never commit it.
#
# These must match the role/database created on the host by
# scripts/setup-ec2.sh (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB env vars
# passed to that script).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=best_employee_app

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
